{{! apps/api/src/modules/pdf/templates/campaign-claim-monthly.hbs }}
<div class="header">
  <div class="header-logo">
    <img src="{{header.logoBase64}}" alt="Logo">
  </div>
  <div class="header-info">
    <div class="company-name-wrapper">
      <div class="company-name">{{header.companyName}}</div>
      <div class="header-line"></div>
      <div class="header-address">
        {{header.address1}}<br>
        {{header.address2}}<br>
        {{header.phone}}
      </div>
    </div>
  </div>
</div>

<div class="document-title" style="font-size: 14px; margin: 10px 0 2px;">
  รายงานเบิกแคมเปญเงินส่งเสริมการขายประจำงวด {{periodLabel}}
</div>
<div class="text-center" style="font-size: 11px; margin-bottom: 6px;">
  ยี่ห้อ: <strong>{{brand}}</strong>
</div>

<table class="claim-table" style="font-size: {{layout.fontPx}}px;">
  {{!-- Widths from claimPdfLayout: fixed columns keep their share, formula
       columns split the rest evenly so many campaigns still fit F14. --}}
  <colgroup>
    <col style="width: {{layout.seq}}%">
    <col style="width: {{layout.name}}%">
    <col style="width: {{layout.model}}%">
    <col style="width: {{layout.vin}}%">
    <col style="width: {{layout.price}}%">
    {{#each expenseColumns}}<col style="width: {{../layout.expense}}%">{{/each}}
    <col style="width: {{layout.total}}%">
    <col style="width: {{layout.date}}%">
  </colgroup>
  <thead>
    <tr>
      <th>ลำดับ</th>
      <th>ชื่อ - สกุล</th>
      <th>แบบรถ</th>
      <th>เลขตัวรถ</th>
      <th>ราคาขาย</th>
      {{#each expenseColumns}}<th>{{this}}</th>{{/each}}
      <th>รวม/คัน</th>
      <th>วันที่แจ้งขาย</th>
    </tr>
  </thead>
  {{#if rows.length}}
  {{#each rows}}
  <tbody class="claim-item">
    <tr class="row-data">
      <td class="tc seq" rowspan="2">{{no}}</td>
      <td>{{customerName}}</td>
      <td>{{modelName}}</td>
      <td class="tc mono">{{vin}}</td>
      <td class="tr">{{#if salePrice}}{{formatCurrency salePrice false}}{{/if}}</td>
      {{#each cells}}<td class="tr">{{#if this}}{{formatCurrency this false}}{{/if}}</td>{{/each}}
      <td class="tr strong">{{#if total}}{{formatCurrency total false}}{{/if}}</td>
      <td class="tc">{{#if notifyDate}}{{formatThaiDate notifyDate 'short'}}{{/if}}</td>
    </tr>
    <tr class="row-write">
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      {{#each cells}}<td></td>{{/each}}
      <td></td>
      <td></td>
    </tr>
  </tbody>
  {{/each}}
  <tbody>
    <tr class="row-total">
      <td colspan="5" class="tr strong">รวมทั้งสิ้น ({{summary.totalCars}} คัน)</td>
      {{#each summary.columnTotals}}<td class="tr strong">{{formatCurrency this false}}</td>{{/each}}
      <td class="tr strong">{{formatCurrency summary.grandTotal false}}</td>
      <td></td>
    </tr>
  </tbody>
  {{else}}
  <tbody>
    <tr>
      <td colspan="12" class="tc muted">ไม่มีรายการเบิกแคมเปญในช่วงเวลานี้</td>
    </tr>
  </tbody>
  {{/if}}
</table>

<div class="claim-footer">
  <div class="sign-block">
    <div>ลงชื่อ .................................................. ผู้จัดทำ</div>
    <div class="sign-date">วันที่ ........../........../..........</div>
  </div>
  <div class="sign-block">
    <div>ลงชื่อ .................................................. ผู้อนุมัติ</div>
    <div class="sign-date">วันที่ ........../........../..........</div>
  </div>
</div>
<div class="printed-at">พิมพ์เมื่อ: {{printedAt}}</div>

<style>
  /* F14 landscape = 8.5×14 in → 356mm wide × 216mm tall */
  @page { size: 356mm 216mm; margin: 8mm; }
  .claim-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 8px;
    line-height: 1.2;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .claim-table th, .claim-table td {
    border: 1px solid #374151;
    padding: 1px 3px;
    vertical-align: middle;
    font-size: inherit;
    overflow-wrap: anywhere;
  }
  .claim-table th {
    background: #f3f4f6 !important;
    color: #111827 !important;
    font-weight: bold;
    text-align: center;
    font-size: inherit;
  }
  .claim-table .tc { text-align: center; }
  .claim-table .tr { text-align: right; }
  .claim-table .mono { font-family: monospace; font-size: 7px; }
  .claim-table .strong { font-weight: bold; }
  .claim-table .muted { color: #6b7280; padding: 10px; }
  .claim-table .row-total td { background: #f3f4f6 !important; }
  .claim-table .seq { vertical-align: middle; font-weight: bold; }
  .claim-table .claim-item { page-break-inside: avoid; break-inside: avoid; }
  .claim-table .row-write td {
    height: 18px;
    padding: 8px 3px;
    background: #fff !important;
  }
  .claim-footer {
    display: flex;
    justify-content: space-around;
    margin-top: 18px;
    font-size: 10px;
    page-break-inside: avoid;
  }
  .sign-block { text-align: center; }
  .sign-date { margin-top: 6px; }
  .printed-at { margin-top: 14px; font-size: 8px; color: #6b7280; text-align: right; }
</style>
