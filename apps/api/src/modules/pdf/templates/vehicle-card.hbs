{{!
  Vehicle card (การ์ดรายละเอียดรถยนต์) — values-only overlay for the pre-printed
  green card stock (27 × 21 cm). Every field is absolutely positioned in mm from
  the paper's top-left; positions come from the saved PrintLayout
  ('vehicle-card', editable in the web app), so never hard-code them here.
  layout.offsetX/offsetY shift the whole sheet — the printer-feed calibration knob.
}}
<div class="page ovl" style="transform: translate({{layout.offsetX}}mm, {{layout.offsetY}}mm); font-size: {{layout.fontSize}}px; font-family: {{fontFamilyCss}};">
  <style>
    .ovl {
      position: relative;
      width: 270mm;
      height: 210mm;
      margin: 0;
      padding: 0;
      overflow: hidden;
      color: #000;
      line-height: 1.1;
    }
    .ovl .f {
      position: absolute;
      height: 6.6mm;
      line-height: 6.6mm;
      white-space: nowrap;
      overflow: hidden;
      color: #000;
      background: transparent;
    }
  </style>
  {{#each fields}}
  <div class="f f-{{key}}" style="top: {{y}}mm; left: {{x}}mm; width: {{w}}mm; text-align: {{align}};{{#if bold}} font-weight: bold;{{/if}}{{#if fontSize}} font-size: {{fontSize}}px;{{/if}}">{{value}}</div>
  {{/each}}
</div>
